{
  "name": "reign",
  "version": "0.1.0",
  "description": "Reign \u2014 document reader built with Svelte 5, Tauri 2 and pdf.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run check && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "export:source": "node scripts/export-app-source.mjs --split",
    "export:frontend": "node scripts/export-app-source.mjs --scope=frontend --split",
    "export:backend": "node scripts/export-app-source.mjs --scope=backend --split",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^0.43.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
